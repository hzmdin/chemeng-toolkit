def calc_div(u_func, v_func, w_func, x, y, z, h=1e-5):
    dudx = (u_func(x+h,y,z)-u_func(x-h,y,z))/(2*h)
    dvdy = (v_func(x,y+h,z)-v_func(x,y-h,z))/(2*h)
    dwdz = (w_func(x,y,z+h)-w_func(x,y,z-h))/(2*h)
    div = dudx+dvdy+dwdz
    return div

def calc_curl(u_func, v_func, w_func, x, y, z, h=1e-5):
    dwdy = (w_func(x,y+h,z)-w_func(x,y-h,z))/(2*h)
    dvdz = (v_func(x,y,z+h)-v_func(x,y,z-h))/(2*h)
    i_curl = dwdy-dvdz
    dudz = (u_func(x,y,z+h)-u_func(x,y,z-h))/(2*h)
    dwdx = (w_func(x+h,y,z)-w_func(x-h,y,z))/(2*h)
    j_curl = dudz-dwdx
    dvdx = (v_func(x+h,y,z)-v_func(x-h,y,z))/(2*h)
    dudy = (u_func(x,y+h,z)-u_func(x,y-h,z))/(2*h)
    k_curl = dvdx-dudy
    curl = [i_curl, j_curl, k_curl]
    magn_of_curl = math.sqrt(curl[0]**2 + curl[1]**2 + curl[2]**2)
    return magn_of_curl

def analyze_fluid_element(u_func, v_func, w_func, x, y, z):
    div = calc_div(u_func, v_func, w_func, x, y, z)
    curl = calc_curl(u_func, v_func, w_func, x, y, z)
    if abs(div) < 1e-4:
        print("Incompressible")
    if abs(curl) < 1e-4:
        print("Irrotational")
    return div, curl

