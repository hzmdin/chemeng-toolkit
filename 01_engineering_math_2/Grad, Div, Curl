import sympy as sp
from sympy.vector import CoordSys3D, divergence, curl, gradient
import pandas as pd

N = CoordSys3D('N')
x, y, z = N.x, N.y, N.z
scalar_field = N.x*N.y*N.z
vector_field = N.i + N.j + N.k

def calc_grad(N, scalar_field):
    return gradient(scalar_field)

def calc_divergence(N, scalar_field, vector_field):
    return divergence(scalar_field*vector_field)

def calc_curl(N, scalar_field):
    return curl(scalar_field*N.i)

grad = calc_grad(N, scalar_field)
div = calc_divergence(N, scalar_field, vector_field)
cur = calc_curl(N, scalar_field)

data = {
    "Gradient" : [grad],
    "Divergence" : [div],
    "Curl" : [cur]
}

df = pd.DataFrame(data)
print(df.to_string(index=False))