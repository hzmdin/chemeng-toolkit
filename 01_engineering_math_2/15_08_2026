import math

def evaluate_3d_line(r0,v,t_values):
    x0,y0,z0 = r0
    a,b,c = v
    points = []

    for t in (t_values):
        x_val = x0 + a*t
        y_val = y0 + b*t
        z_val = z0 + c*t
        points.append([x_val, y_val, z_val])

    return points

def vector_distance(p1,p2):
    x1,y1,z1 = p1
    x2,y2,z2 = p2

    d = math.sqrt((x2-x1)**2+(y2-y1)**2+(z2-z1)**2)
    return d

r0 = (1.0, 2.0, 0.0)
v = (3.0, -1.0, 4.0)
t = [0.0, 5.0]

points = evaluate_3d_line(r0,v,t)

print("Your initial coordinates and final coordinates are ", points)

d = vector_distance(points[0],points[1])
print(d)

